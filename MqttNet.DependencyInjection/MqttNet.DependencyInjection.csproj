<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageReadmeFile>README.md</PackageReadmeFile>
	<RepositoryUrl>https://github.com/jinzaz/MqttNet.DependencyInjection.git</RepositoryUrl>
	<PackageProjectUrl>https://github.com/jinzaz/MqttNet.DependencyInjection</PackageProjectUrl>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<Title>MqttNet Client DependencyInjection in AspNetCore</Title>
	<Authors>john.jiang</Authors>
	<Version>1.0.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="3.1.25" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="3.1.25" />
    <PackageReference Include="MQTTnet" Version="4.3.6.1152" />
    <!-- MqttNetDI.Client 打包进本包，其依赖需在此声明 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- MqttNetDI.Client 未单独发布到 NuGet，将其 dll 一并打包，避免包依赖不存在 -->
    <ProjectReference Include="..\MqttNetDI.Client\MqttNetDI.Client.csproj" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeReferencedProjects</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="IncludeReferencedProjects" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
    </ItemGroup>
  </Target>
</Project>
